# SGS Trader Configuration
# Copy this file to .env and fill in your actual keys

# Financial Modeling Prep API Key
# Get yours at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# OpenAI API Key (for GPT-4 LLM extraction)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (default: gpt-4-turbo)
# Options: gpt-4-turbo, gpt-4, gpt-4-turbo-preview, etc.
OPENAI_MODEL=gpt-4-turbo

# Slack Incoming Webhook URL (for alerts)
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Database path (relative to project root)
DB_PATH=sgs.db

# Timezone (for scheduling)
TIMEZONE=America/New_York

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
